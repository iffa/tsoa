{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Mocha TS Tests",
      "program": "${workspaceRoot}/node_modules/mocha/bin/_mocha",
      "cwd": "${workspaceRoot}/tests",
      "env": {
        "NODE_ENV": "tsoa_test"
      },
      "args": ["**/*.spec.ts"],
      "runtimeArgs": ["--inspect", "--inspect-brk"],
      "preLaunchTask": "prepareFiles",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Mocha TS Tests: Current File",
      "program": "${workspaceRoot}/node_modules/mocha/bin/_mocha",
      "cwd": "${workspaceRoot}/tests",
      "env": {
        "NODE_ENV": "tsoa_test"
      },
      "args": ["${file}", "--timeout", "0"],
      "runtimeArgs": ["--inspect", "--inspect-brk"],
      "preLaunchTask": "prepareFiles",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Generate",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceRoot}/packages/tsoa/src/cli.ts", "spec"],
      "cwd": "${workspaceRoot}/tests",
      "preLaunchTask": "build",
      "runtimeArgs": ["--import", "tsx"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Pretest",
      "type": "node",
      "request": "launch",
      "args": ["${workspaceRoot}/tests/prepare.ts"],
      "cwd": "${workspaceRoot}/tests",
      "runtimeArgs": ["--import", "tsx"],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
