{
  "name": "@tsoa/runtime",
  "description": "Build swagger-compliant REST APIs using TypeScript and Node",
  "version": "7.0.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routeGeneration/templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "openapi",
    "swagger",
    "server",
    "node",
    "node.js",
    "codegen",
    "generation",
    "express"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn run -T build",
    "clean": "rimraf dist",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js --noEmit",
    "watch": "tsdown --watch"
  },
  "author": "Luke Autry <lukeautry@gmail.com> (http://www.lukeautry.com)",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "2.3.0",
    "reflect-metadata": "0.2.2",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/validator": "13.15.10",
    "express": "5.2.1"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iffa/tsoa.git"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "engineStrict": true,
  "publishConfig": {
    "access": "public"
  }
}
