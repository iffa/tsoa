{
  "name": "tsoa",
  "description": "Build swagger-compliant REST APIs using TypeScript and Node",
  "version": "7.0.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "openapi",
    "swagger",
    "server",
    "node",
    "node.js",
    "codegen",
    "generation",
    "express"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn run -T build",
    "clean": "rimraf dist",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js --noEmit",
    "watch": "tsdown --watch"
  },
  "author": "Luke Autry <lukeautry@gmail.com> (http://www.lukeautry.com)",
  "license": "MIT",
  "dependencies": {
    "@tsoa/cli": "workspace:^",
    "@tsoa/runtime": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iffa/tsoa.git"
  },
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "engineStrict": true,
  "publishConfig": {
    "access": "public"
  }
}
