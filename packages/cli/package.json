{
  "name": "@tsoa/cli",
  "description": "Build swagger-compliant REST APIs using TypeScript and Node",
  "version": "7.0.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "openapi",
    "swagger",
    "server",
    "node",
    "node.js",
    "codegen",
    "generation",
    "express"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn run -T build",
    "clean": "rimraf dist",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js --noEmit",
    "watch": "tsdown --watch"
  },
  "author": "Luke Autry <lukeautry@gmail.com> (http://www.lukeautry.com)",
  "license": "MIT",
  "dependencies": {
    "@tsoa/runtime": "workspace:^",
    "handlebars": "4.7.10",
    "merge-anything": "6.0.9",
    "minimatch": "10.2.6",
    "ts-deepmerge": "8.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "validator": "13.15.35",
    "yaml": "2.9.1",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@types/validator": "13.15.10",
    "@types/yargs": "17.0.35"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iffa/tsoa.git"
  },
  "bin": {
    "tsoa": "dist/bin.js"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "engineStrict": true,
  "publishConfig": {
    "access": "public"
  }
}
