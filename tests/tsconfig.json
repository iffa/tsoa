{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "paths": {
      "@iffa/tsoa-cli/*": ["../packages/cli/src/*"],
      "@iffa/tsoa-runtime/*": ["../packages/runtime/src/*"]
