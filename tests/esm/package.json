{
  "name": "tsoa-tests-esm",
  "private": true,
  "description": "Build swagger-compliant REST APIs using TypeScript and Node",
  "version": "6.6.1",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "node ../../scripts/clean-routes.mjs",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js --noEmit",
    "test": "yarn clean && tsx prepare.ts && tsx ../typecheck-generated.ts && cross-env NODE_ENV=tsoa_test mocha"
  },
  "author": "Luke Autry <lukeautry@gmail.com> (http://www.lukeautry.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeautry/tsoa.git"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "engineStrict": true,
  "devDependencies": {
    "@tsoa/cli": "workspace:^",
    "@tsoa/runtime": "workspace:^",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.19.1",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "chalk": "5.6.2",
    "cross-env": "10.1.0",
    "mocha": "12.0.3",
    "tsoa": "workspace:^"
  }
}
